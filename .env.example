# Backend (Go) — copy to .env and adjust. .env.dev provides these dev
# defaults already; this file documents every variable the app reads.

# Runtime profile: development | qa | production.
# development seeds a known admin login (admin@mail.com); qa/prod never do.
NODE_ENV=development

# PostgreSQL connection. Required. Tables apply automatically on start.
DATABASE_URL="postgres://user:password@localhost:5432/go_template?sslmode=disable"

# Authentication — REQUIRED in production (the server refuses to boot
# without it); falls back to a dev-only secret otherwise.
JWT_SECRET="your-secret-key-here-change-in-production"

# Listen port for the Go API (the Next.js frontend lives on 3000).
PORT=8080

# email
MAIL_FROM="tom@email.com"
MAX_ATTEMPTS=2
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"

# email verification gate (login + /api/me). Leave unset to require it.
EMAIL_VERIFICATION_REQUIRED=false

# Used in verification / reset links sent by email.
FRONTEND_URL="http://localhost:3000"

# Frontend: where the Next.js server proxies /api/* to (server-side — the
# browser never talks to the Go API directly). Only set if the API lives
# somewhere other than http://localhost:8080.
# API_URL="http://api.internal:8080"
#
# Split-domain deployment that calls the Go API from the browser directly?
# Set NEXT_PUBLIC_API_URL instead (build-time, inlined into the client bundle;
# re-enable CORS in backend/app.go if you do this).
# NEXT_PUBLIC_API_URL="https://api.example.com"

# Failed logins before a temporary 15-minute lockout (default 5).
LOGIN_MAX_ATTEMPTS=5

# Lockout window in minutes after exceeding the attempt limit (default 15).
LOGIN_LOCK_MINUTES=15
