# Dev profile — safe to commit, no real secrets. Loaded when NODE_ENV=development
# (the Go backend's default when NODE_ENV is unset). A personal root .env, if
# present, still overrides any of these.
NODE_ENV=development

# Database — PostgreSQL must already be running. Tables (migrations) apply
# automatically when the backend starts.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/go_template?sslmode=disable&search_path=scheduling"


# Authentication
JWT_SECRET="dev-only-secret-not-for-qa-or-prod"

# email — unset SMTP_HOST means mail is logged to stdout, not sent
MAIL_FROM="tom@email.com"
MAX_ATTEMPTS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# email verification — bypassed locally so signup/login don't need real mail
EMAIL_VERIFICATION_REQUIRED=false
FRONTEND_URL="http://localhost:3000"

# failed logins before a temporary lockout (default 5)
LOGIN_MAX_ATTEMPTS=5

# lockout window in minutes after exceeding the attempt limit (default 15)
LOGIN_LOCK_MINUTES=15
