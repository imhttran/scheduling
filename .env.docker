# Docker environment configuration
# Copy to .env to override defaults

# Ports (different from manage.sh: 3000/8080)
FRONTEND_PORT=3001
BACKEND_PORT=8081
POSTGRES_PORT=5433

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheduling

# Backend
DATABASE_URL=postgres://postgres:postgres@postgres:5432/scheduling?sslmode=disable
